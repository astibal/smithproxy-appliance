#!/usr/bin/env python3
import os
from pathlib import Path
import sys

# Use the installed project dependencies without requiring manual activation.
# Keep the caller's working directory for relative config and file arguments.
_script = Path(__file__).resolve()
for _environment in (_script.parent / ".venv", _script.parent / "console/.venv"):
    _python = _environment / "bin/python"
    if _python.is_file() and os.access(_python, os.X_OK):
        if Path(sys.prefix).resolve() != _environment.resolve():
            os.execv(str(_python), [str(_python), str(_script), *sys.argv[1:]])
        break

from sas_client.cli import main

raise SystemExit(main())
