[Unit]
Description=Smithproxy Appliance Service runner
Documentation=file:/opt/smithproxy-appliance/docs/SYSTEMD.md
Wants=network-online.target
After=network-online.target dbus.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/smithproxy-appliance
EnvironmentFile=/etc/smithproxy-appliance/runner.env
EnvironmentFile=/etc/smithproxy-appliance/runner-client.env
ExecStart=/usr/bin/python3 -m runner.app
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

StateDirectory=smithproxy-appliance
StateDirectoryMode=0700
RuntimeDirectory=smithproxy-appliance
RuntimeDirectoryMode=0700
# Runtime config snapshots must survive an ordinary runner restart because the
# transient Smithproxy units deliberately keep running.
RuntimeDirectoryPreserve=yes

# The runner must retain host networking, mount-namespace visibility and access
# to systemd so it can create netns/veth/nft rules and transient units.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/smithproxy-appliance /run/smithproxy-appliance -/run/netns

# Do not enable PrivateTmp or PrivateMounts: transient native-save processes and
# persistent network namespaces must see paths created by the runner.

[Install]
WantedBy=multi-user.target
