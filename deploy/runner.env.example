CZ_RUNNER_TOKEN=replace-with-at-least-32-random-characters
CZ_RUNNER_HOST=127.0.0.1
CZ_RUNNER_PORT=9080
CZ_RUNNER_MAX_RUNTIME=3600
CZ_RUNNER_MAX_INSTANCES=32
CZ_RUNNER_SMITHPROXY=/usr/local/lib/capture-zone/smithproxy
CZ_RUNNER_TEMPLATE=/etc/capture-zone-runner/smithproxy.cfg.in
CZ_RUNNER_SOURCES=/etc/capture-zone-runner/source-ips.json
CZ_RUNNER_STATE_DIR=/var/lib/capture-zone-runner
CZ_RUNNER_RUNTIME_DIR=/run/capture-zone-runner
CZ_RUNNER_REPOSITORY=https://github.com/astibal/smithproxy.git
CZ_RUNNER_SOURCE_DIR=/var/lib/capture-zone-runner/smithproxy-src
CZ_RUNNER_RUNTIME_PROFILES=/var/lib/capture-zone-runner/runtime-profiles.json
