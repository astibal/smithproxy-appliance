[Unit]
Description=Capture Zone Smithproxy runner
After=network.target dbus.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/smithproxy-appliance
EnvironmentFile=/etc/capture-zone-runner/runner.env
ExecStart=/usr/bin/python3 -m runner.app
Restart=on-failure
RestartSec=2s
UMask=0077

# The runner needs systemd's D-Bus/API to create transient units. Smithproxy
# itself is constrained separately by properties in runner/systemd.py.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/capture-zone-runner /run/netns /var/lib/capture-zone-runner /usr/local/lib/capture-zone

[Install]
WantedBy=multi-user.target
